# Copy to .env for local runs; CI sets these from GitHub Actions secrets.
# Never commit real values.

# Drives jev.mjs's click loop. Get one at console.typesafe.ai.
TYPESAFE_API_KEY=

# Site under test.
TARGET_BASE_URL=https://example.com
TARGET_API_URL=https://api.example.com

# Dedicated, non-admin QA account used only by this check.
QA_TEST_ACCOUNT_EMAIL=
QA_TEST_ACCOUNT_PASSWORD=
